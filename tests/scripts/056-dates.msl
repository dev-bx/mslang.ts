// Дата равна только дате (по моменту времени), с числом — не равна.
let d = DateTime.parse("2023-11-14 22:13:20","YYYY-MM-DD HH:mm:ss");
return [DateTime.fromTimestamp(1700000000).format("YYYY-MM-DD HH:mm:ss"), DateTime.parse("14.03.2024","DD.MM.YYYY").format("DD/MM/YYYY"), d == DateTime.fromTimestamp(1700000000), d == 1700000000];
